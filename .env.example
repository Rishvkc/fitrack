# Turso database (use file:local.db for local dev)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Bearer token for Apple Shortcuts POST /api/log
SHORTCUT_SECRET=your-secret-token-here

# Hugging Face fine-grained token with "Make calls to Inference Providers" enabled
# Create at https://huggingface.co/settings/tokens (not a classic read token)
HUGGINGFACE_API_KEY=

# Optional: override the default Llama model
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
